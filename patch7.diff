 *{box-sizing:border-box}
 html{scroll-behavior:smooth}
-body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 -apple-system,"Segoe UI",Inter,Roboto,"Helvetica Neue",Arial,sans-serif}
+body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 var(--sans)}
 a{color:inherit;text-decoration:none}
-button,input,select{font:inherit;color:inherit}
-.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
-.demo-bar{background:var(--warn-soft);color:var(--warn);font-size:12.5px;text-align:center;padding:6px 12px}
+button,input,select,textarea{font:inherit;color:inherit}
+.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
+.demo-bar{background:var(--warn-soft);color:var(--warn);font-size:12.5px;text-align:center;padding:6px 12px;border-bottom:1px solid var(--warn-line)}
 .top{background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
-.top-in{display:flex;align-items:center;gap:22px;height:64px}
-.logo{display:flex;align-items:center;gap:8px;font-weight:700;font-size:20px;letter-spacing:-.3px}
-.logo-mark{background:var(--navy);color:#fff;border-radius:9px;padding:4px 7px;font-size:14px}
-nav{display:flex;gap:20px}
-nav a{padding:20px 2px;font-weight:600;color:var(--muted);border-bottom:2px solid transparent}
+.top-in{display:flex;align-items:center;gap:24px;height:60px}
+.logo{display:flex;align-items:center;gap:8px;font-weight:700;font-size:17px}
+.logo-mark{display:inline-block;width:10px;height:10px;background:var(--ai);border-radius:2px;font-size:0;color:transparent;padding:0}
+nav{display:flex;gap:22px}
+nav a{padding:20px 2px;font-weight:500;font-size:14px;color:var(--muted);border-bottom:2px solid transparent}
 nav a.on,nav a:hover{color:var(--ink);border-color:var(--ai)}
-.pill{background:var(--ai);color:#fff;border-radius:10px;font-size:11px;padding:1px 6px;margin-left:3px}
-.search{flex:1;max-width:380px;margin-left:auto}
-.search input{width:100%;border:1px solid var(--line);background:var(--bg);border-radius:12px;padding:9px 14px}
-.seller-link{font-weight:600;color:var(--muted);white-space:nowrap}
+nav a.on{font-weight:600}
+.pill{background:var(--ai);color:#fff;border-radius:4px;font-family:var(--mono);font-size:11px;padding:1px 6px;margin-left:3px}
+.search{flex:1;max-width:360px;margin-left:auto}
+.search input{width:100%;border:1px solid var(--line);background:var(--bg);border-radius:8px;padding:8px 12px;font-size:14px}
+.search input:focus,.try textarea:focus,.chat-form input:focus{outline:2px solid var(--ai);outline-offset:1px}
+.seller-link{font-weight:500;font-size:14px;color:var(--muted);white-space:nowrap}
 .seller-link:hover{color:var(--ink)}
